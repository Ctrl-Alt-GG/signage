# Rendered by the nginx image entrypoint together with backend.inc.template; ${BACKEND_URL}
# and ${TRUSTED_PROXY} are the substituted variables.

# The host's reverse proxy reaches this server through the compose network's gateway,
# TRUSTED_PROXY, so every request it passes on comes from that one address. Its
# X-Forwarded-For names the client, which the limits below then count instead of the
# gateway. Anyone else reaches the published port with their own address and cannot
# choose one by sending the header.
set_real_ip_from ${TRUSTED_PROXY};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

geo $realip_remote_addr $signage_from_proxy {
    default 0;
    ${TRUSTED_PROXY} 1;
}

# The proxy terminates TLS and says so in X-Forwarded-Proto. Django needs that answer,
# not this server's own scheme, which is always http. From anyone but the proxy the header
# is ignored, and the scheme of this connection is the truth.
map "$signage_from_proxy:$http_x_forwarded_proto" $signage_forwarded_proto {
    default   $scheme;
    "1:https" https;
    "1:http"  http;
}

# The API is anonymous, and some of its answers are built from upstream systems. A screen
# asks every few seconds; this leaves room for a wall of them behind one address and
# stops a single client from doing more.
limit_req_zone $binary_remote_addr zone=signage_api:1m rate=20r/s;
map $request_method $signage_login_key {
    default "";
    POST $binary_remote_addr;
}
limit_req_zone $signage_login_key zone=signage_login:1m rate=6r/m;

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml font/woff2;

    # Hashed build output: cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff";
        try_files $uri =404;
    }

    # The static files of the Django admin, collected when this image was built.
    location /static/ {
        alias /usr/share/nginx/static/;
        add_header Cache-Control "public, max-age=3600";
        add_header X-Content-Type-Options "nosniff";
        try_files $uri =404;
    }

    location = /admin {
        return 301 /admin/;
    }

    location = /admin/login/ {
        limit_req zone=signage_login burst=5 nodelay;
        limit_req_status 429;
        include /etc/nginx/conf.d/backend.inc;
    }

    location /api/ {
        limit_req zone=signage_api burst=40 nodelay;
        limit_req_status 429;
        include /etc/nginx/conf.d/backend.inc;
    }

    # Everything else the backend owns. The regex location keeps the request URI intact.
    location ~ ^/(admin|health)/ {
        include /etc/nginx/conf.d/backend.inc;
    }

    # The single-page app: every other path renders index.html and the router takes over.
    # It loads nothing from other origins, and the admin overview is the only page that
    # frames it.
    location / {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'";
        add_header Referrer-Policy "same-origin";
        add_header X-Content-Type-Options "nosniff";
        try_files $uri /index.html;
    }
}
