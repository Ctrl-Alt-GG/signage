COMPOSE_PROJECT_NAME=signage
GHCR_NAMESPACE=ctrl-alt-gg
APP_IMAGE_TAG=v0.1.0

# Where the frontend and MinIO listen on the host. 127.0.0.1 expects the host's reverse
# proxy (with TLS) in front; 0.0.0.0 serves the venue LAN directly.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

PUBLIC_BASE_URL=https://signage.ctrl-alt-gg.hu
DJANGO_SECRET_KEY=change-this-to-a-long-random-value
# 127.0.0.1 stays in the list for the container health check.
DJANGO_ALLOWED_HOSTS=signage.ctrl-alt-gg.hu,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://signage.ctrl-alt-gg.hu
# Set both to false when the stack is reached over plain http on the venue LAN.
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=0
LOG_LEVEL=INFO
TIME_ZONE=Europe/Budapest

POSTGRES_USER=signage
POSTGRES_PASSWORD=change-postgres-password
POSTGRES_DB=signage
DATABASE_URL=postgresql://signage:change-postgres-password@postgres:5432/signage

# Object storage. The backend talks to MinIO at STORAGE_ENDPOINT_URL with the root
# credentials (compose.yaml maps them to STORAGE_ACCESS_KEY and STORAGE_SECRET_KEY).
# Browsers load the admin's static files and the background from STORAGE_PUBLIC_URL, which
# may carry a path when the reverse proxy mounts MinIO under a prefix.
MINIO_ROOT_USER=signage
MINIO_ROOT_PASSWORD=change-minio-password
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_PUBLIC_URL=https://signage.ctrl-alt-gg.hu:9000
STORAGE_BUCKET=signage

CACHE_DIR=/tmp/signage-cache
SIGNAGE_DEFAULT_SCREEN=main
SIGNAGE_LAST_GOOD_SECONDS=3600

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30
