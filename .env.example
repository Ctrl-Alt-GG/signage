COMPOSE_PROJECT_NAME=signage
GHCR_NAMESPACE=ctrl-alt-gg
APP_IMAGE_TAG=v0.1.0

# Where the frontend listens on the host. 127.0.0.1 expects the host's reverse proxy in
# front, which terminates TLS and sends X-Forwarded-Proto. The admin only works that way:
# it redirects plain HTTP to HTTPS and its cookies are never sent without TLS, because on
# the venue network anyone could read a password sent in the clear.
# 0.0.0.0 also serves the venue LAN directly. Screens can load the display from there
# over plain HTTP; they need no login.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080

PUBLIC_BASE_URL=https://signage.ctrl-alt-gg.hu
DJANGO_SECRET_KEY=change-this-to-a-long-random-value
# 127.0.0.1 stays in the list for the container health check. Add the address the screens
# use when they load the display from the LAN directly.
DJANGO_ALLOWED_HOSTS=signage.ctrl-alt-gg.hu,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://signage.ctrl-alt-gg.hu
DJANGO_SECURE_HSTS_SECONDS=0
LOG_LEVEL=INFO
TIME_ZONE=Europe/Budapest

POSTGRES_USER=signage
POSTGRES_PASSWORD=change-postgres-password
POSTGRES_DB=signage
DATABASE_URL=postgresql://signage:change-postgres-password@postgres:5432/signage

CACHE_DIR=/tmp/signage-cache
SIGNAGE_LAST_GOOD_SECONDS=3600

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30
